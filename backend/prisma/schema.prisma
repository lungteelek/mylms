generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id           Int              @id @default(autoincrement())
  name         String
  slug         String           @unique
  memberships  TenantMembership[]
  courses      Course[]
  modules      Module[]
  quizzes      Quiz[]
  questions    Question[]
  enrollments  Enrollment[]
  quizAttempts QuizAttempt[]
  licenses     License[]
  featureFlags FeatureFlag[]
  billingProfile TutorBillingProfile?
  coursePricings CoursePricing[]
  discountCampaigns DiscountCampaign[]
  discountRedemptions DiscountRedemption[]
  studentOrders StudentOrder[]
  tutorPayouts TutorPayout[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model User {
  id            Int                @id @default(autoincrement())
  email         String             @unique
  name          String?
  password      String
  platformRole  PlatformRole       @default(USER)
  memberships   TenantMembership[]
  courses       Course[]           @relation("InstructorCourses")
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
  studentOrders StudentOrder[]
  discountRedemptions DiscountRedemption[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model TenantMembership {
  id         Int        @id @default(autoincrement())
  userId     Int
  tenantId   Int
  role       TenantRole @default(STUDENT)
  isDefault  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id])
  tenant     Organization @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

enum PlatformRole {
  USER
  ADMIN
}

enum TenantRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  OWNER
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum TutorBillingModel {
  MONTHLY
  REVENUE_SHARE
}

enum CheckoutOwner {
  PLATFORM
  TUTOR
}

enum StudentAccountMode {
  PLATFORM_MANAGED
  TUTOR_MANAGED
}

enum DiscountCampaignMode {
  AUTO
  CODE
}

enum DiscountType {
  PERCENT
  AMOUNT
  FREE
}

enum DiscountStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Course {
  id           Int          @id @default(autoincrement())
  tenantId     Int
  title        String
  slug         String?
  status       String       @default("draft")
  publishedAt  DateTime?
  description  String?
  subject      String?
  level        String?
  instructorId Int
  tenant       Organization @relation(fields: [tenantId], references: [id])
  instructor   User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  modules      Module[]
  enrollments  Enrollment[]
  pricing      CoursePricing?
  discountCampaigns DiscountCampaign[]
  studentOrders StudentOrder[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  courseOrder  Int          @default(0)
}

model Module {
  id          Int          @id @default(autoincrement())
  tenantId    Int
  title       String
  content     String?      // Text content
  videoUrl    String?      // Path to local video or remote
  courseId    Int
  tenant      Organization @relation(fields: [tenantId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  quizzes     Quiz[]
  order       Int          @default(0)
  estimatedMinutes Int      @default(0)
  parentId    Int?
  nodeType    String       @default("LESSON")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Quiz {
  id        Int          @id @default(autoincrement())
  tenantId  Int
  title     String
  moduleId  Int
  tenant    Organization @relation(fields: [tenantId], references: [id])
  module    Module       @relation(fields: [moduleId], references: [id])
  questions Question[]
  attempts  QuizAttempt[]
  createdAt DateTime     @default(now())
}

model Question {
  id            Int          @id @default(autoincrement())
  tenantId      Int
  text          String
  options       Json // JSON array of strings for choices
  correctAnswer Int      // Index of correct option
  quizId        Int
  tenant        Organization @relation(fields: [tenantId], references: [id])
  quiz          Quiz         @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id        Int          @id @default(autoincrement())
  tenantId  Int
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  quizId    Int
  tenant    Organization @relation(fields: [tenantId], references: [id])
  quiz      Quiz         @relation(fields: [quizId], references: [id])
  score     Int          // Number of correct answers
  total     Int          // Total number of questions
  createdAt DateTime     @default(now())
}

model Enrollment {
  id        Int          @id @default(autoincrement())
  tenantId  Int
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  courseId  Int
  orderId   Int?         @unique
  tenant    Organization @relation(fields: [tenantId], references: [id])
  course    Course       @relation(fields: [courseId], references: [id])
  order     StudentOrder? @relation(fields: [orderId], references: [id])
  discountRedemptions DiscountRedemption[]
  progress  Float        @default(0.0) // 0 to 100
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, userId, courseId])
}

model License {
  id            Int           @id @default(autoincrement())
  tenantId      Int           @unique
  status        LicenseStatus @default(TRIAL)
  plan          String        @default("starter")
  seats         Int?
  expiresAt     DateTime?
  issuedTo      String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Organization  @relation(fields: [tenantId], references: [id])
}

model FeatureFlag {
  id         Int          @id @default(autoincrement())
  tenantId   Int
  key        String
  enabled    Boolean      @default(false)
  value      Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant     Organization @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

model PlatformPricingConfig {
  id         Int      @id @default(autoincrement())
  key        String   @unique @default("default")
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TutorBillingProfile {
  id                Int               @id @default(autoincrement())
  tenantId          Int               @unique
  billingModel      TutorBillingModel @default(REVENUE_SHARE)
  checkoutOwner     CheckoutOwner     @default(PLATFORM)
  studentAccountMode StudentAccountMode @default(PLATFORM_MANAGED)
  monthlyFeeMinor   Int?
  revenueSharePct   Float?
  settlementDelayDays Int             @default(7)
  currency          String            @default("THB")
  active            Boolean           @default(true)
  notes             String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Organization      @relation(fields: [tenantId], references: [id])
  coursePricings    CoursePricing[]
  discountCampaigns DiscountCampaign[]
  payouts           TutorPayout[]
}

model CoursePricing {
  id               Int          @id @default(autoincrement())
  tenantId         Int
  courseId         Int          @unique
  tutorBillingProfileId Int?
  priceMinor       Int
  compareAtPriceMinor Int?
  currency         String       @default("THB")
  allowCoupons     Boolean      @default(true)
  allowPromotions  Boolean      @default(true)
  showPricePublicly Boolean     @default(true)
  salesStartsAt    DateTime?
  salesEndsAt      DateTime?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tenant           Organization @relation(fields: [tenantId], references: [id])
  course           Course       @relation(fields: [courseId], references: [id])
  billingProfile   TutorBillingProfile? @relation(fields: [tutorBillingProfileId], references: [id])
}

model DiscountCampaign {
  id                    Int                @id @default(autoincrement())
  tenantId              Int
  courseId              Int?
  tutorBillingProfileId  Int?
  mode                  DiscountCampaignMode @default(AUTO)
  code                  String?
  name                  String
  description           String?
  discountType          DiscountType
  discountValue         Float?
  discountAmountMinor   Int?
  currency              String             @default("THB")
  status                DiscountStatus     @default(DRAFT)
  stackable             Boolean            @default(false)
  priority              Int                @default(0)
  maxRedemptions        Int?
  maxRedemptionsPerStudent Int?
  startsAt              DateTime?
  endsAt                DateTime?
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenant                Organization       @relation(fields: [tenantId], references: [id])
  course                Course?            @relation(fields: [courseId], references: [id])
  billingProfile        TutorBillingProfile? @relation(fields: [tutorBillingProfileId], references: [id])
  redemptions           DiscountRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId, courseId, status])
}

model DiscountRedemption {
  id                 Int              @id @default(autoincrement())
  tenantId           Int
  campaignId         Int
  userId             Int
  orderId            Int?             @unique
  enrollmentId       Int?             @unique
  discountAmountMinor Int?
  currency           String           @default("THB")
  redeemedAt         DateTime         @default(now())
  metadata           Json?
  tenant             Organization     @relation(fields: [tenantId], references: [id])
  campaign           DiscountCampaign @relation(fields: [campaignId], references: [id])
  user               User             @relation(fields: [userId], references: [id])
  order              StudentOrder?    @relation(fields: [orderId], references: [id])
  enrollment         Enrollment?      @relation(fields: [enrollmentId], references: [id])

  @@index([tenantId, campaignId])
  @@index([tenantId, userId])
}

model StudentOrder {
  id                    Int          @id @default(autoincrement())
  tenantId              Int
  courseId              Int
  userId                Int
  billingModel          TutorBillingModel
  checkoutOwner         CheckoutOwner
  status                OrderStatus   @default(PENDING)
  grossAmountMinor      Int
  discountAmountMinor   Int           @default(0)
  netAmountMinor        Int
  currency              String        @default("THB")
  paymentProvider       String?
  providerSessionId     String?
  providerPaymentId     String?
  platformFeeMinor      Int?
  tutorPayoutMinor      Int?
  pricingSnapshot       Json?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Organization  @relation(fields: [tenantId], references: [id])
  course                Course        @relation(fields: [courseId], references: [id])
  user                  User          @relation(fields: [userId], references: [id])
  enrollment            Enrollment?
  discountRedemptions   DiscountRedemption[]

  @@index([tenantId, courseId, status])
  @@index([tenantId, userId, status])
}

model TutorPayout {
  id                 Int               @id @default(autoincrement())
  tenantId           Int
  billingProfileId    Int?
  status             PayoutStatus      @default(PENDING)
  grossAmountMinor   Int
  platformFeeMinor   Int               @default(0)
  tutorNetAmountMinor Int
  currency           String            @default("THB")
  provider          String?
  providerPayoutId  String?
  settledAt         DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Organization      @relation(fields: [tenantId], references: [id])
  billingProfile    TutorBillingProfile? @relation(fields: [billingProfileId], references: [id])

  @@index([tenantId, status])
}
