DATABASE_URL=file:./data/mylms.db
PORT=3000
JWT_SECRET=change-me
DEFAULT_TENANT_SLUG=coursechic
APP_DOMAIN=coursechic.com
SELF_HOSTED_LICENSE_KEY=self-hosted-demo
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Cloudflare R2 media storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Public custom domain or r2.dev URL, without a trailing slash.
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Video upload/transcode settings
MEDIA_UPLOAD_MAX_MB=2048
MEDIA_CHUNK_SIZE_MB=8
MEDIA_TOKEN_TTL_SECONDS=900
MEDIA_SESSION_TTL_MS=86400000
MEDIA_CLEANUP_INTERVAL_MS=3600000
MEDIA_JOB_TTL_MS=86400000
MEDIA_JOB_POLL_MS=5000
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
