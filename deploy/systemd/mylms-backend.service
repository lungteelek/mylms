[Unit]
Description=MyLMS Backend
After=network.target

[Service]
Type=simple
User=mylms
WorkingDirectory=/home/mylms/mylms_project/backend
Environment=NODE_ENV=production
EnvironmentFile=/home/mylms/mylms_project/backend/.env
ExecStart=/usr/bin/node /home/mylms/mylms_project/backend/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
