    "handoff:update": "bash ./scripts/handoff-update.sh",
    "handoff:resume": "bash ./scripts/handoff-resume.sh",
    "educator:dev": "npm run dev --prefix educator-web",
    "educator:build": "npm run build --prefix educator-web",
    "educator:start": "npm run start --prefix educator-web",
    "student:dev": "npm run dev --prefix student-web",
    "student:build": "npm run build --prefix student-web",
    "student:start": "npm run start --prefix student-web"
